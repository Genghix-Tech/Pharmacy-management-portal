# ---------------------------------------------------------------------------
# PharmaFlow environment variables
#
# Copy this file to .env.local for local development, or configure the same
# keys in your Vercel project settings (Project → Settings → Environment
# Variables) for production/preview deployments. Never commit real values.
# ---------------------------------------------------------------------------

# Supabase project URL and anon (public) key.
# Find both under Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The public URL this app is deployed at. Used to build email confirmation
# and password reset redirect links. Use http://localhost:3000 locally and
# your Vercel production URL (e.g. https://pharmaflow.vercel.app) in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
